# Copie ce fichier en .env.local (non versionné, voir .gitignore) et
# renseigne tes valeurs depuis le dashboard Supabase : Project Settings > API.
# Le préfixe VITE_ est requis par Vite pour exposer une variable au client.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé "publishable" (anciennement "anon public") — prévue pour être exposée
# côté client, protégée par Row Level Security. Ne jamais mettre ici la clé
# "secret" / service_role, qui contourne RLS et ne doit jamais quitter le
# serveur.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
